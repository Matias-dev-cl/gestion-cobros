# Referencia: estas variables deben exportarse en la terminal; Django no carga este archivo automáticamente.
DJANGO_SECRET_KEY=GENERAR_UNA_CLAVE_LOCAL
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Opcional: PostgreSQL / Supabase. Sin DB_HOST se usa SQLite.
# DB_HOST=your-database-host
# DB_NAME=postgres
# DB_USER=your-user
# DB_PASSWORD=your-password
# DB_PORT=5432
# DB_SSLMODE=require
